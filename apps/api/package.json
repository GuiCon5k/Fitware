{
  "name": "@fitware/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "restore": "node --env-file-if-exists=../../.env --import tsx src/restore.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mercadopago": "^3.6.1",
    "nodemailer": "^10.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
