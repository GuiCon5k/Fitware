PORT=3001
APP_ORIGIN=http://localhost:5173
# Si no se define DATABASE_URL, se usa PostgreSQL embebido persistente en .data.
# DATABASE_URL=postgres://fitware:change-me@localhost:5432/fitware
# Obligatorios al iniciar por primera vez (minimo 10 caracteres de contraseña).
ADMIN_EMAIL=dueno@fitware.local
ADMIN_PASSWORD=
RECEPTION_EMAIL=recepcion@fitware.local
RECEPTION_PASSWORD=
# Activar datos ficticios de socios y planes, nunca datos reales.
SEED_DEMO=true

# Suscripción al software FITWare (separada de las cuotas del gimnasio).
# Desactivada por defecto para que puedas probar la app localmente.
REQUIRE_SUBSCRIPTION=false
# Precio del servicio: USD 15, convertido en cada pago a ARS.
# Dólar oficial vendedor de DolarAPI; no se configura un precio fijo en pesos.
# URL pública HTTPS del despliegue (sin barra final). No es localhost.
PUBLIC_URL=
# Credenciales de TU cuenta vendedora de Mercado Pago, nunca del frontend.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
# Solo para pruebas aisladas. No permite pagos de prueba con NODE_ENV=production.
MP_ALLOW_TEST_PAYMENTS=false

# Recuperación de acceso: en local se guarda el enlace en apps/api/.data/mail.
MAIL_MODE=local
# Para enviar emails reales: MAIL_MODE=smtp y completar el remitente privado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Producción requiere APP_ORIGIN con HTTPS y SMTP configurado.
# Rutas relativas al proceso API (apps/api). Respaldos diarios con servidor encendido.
# DATA_DIRECTORY=.data/postgres
# BACKUP_DIRECTORY=.backups

# Cuotas del gimnasio: conexión independiente de la suscripción de FITWare.
# Solo para la sede indicada. Credenciales privadas de su cuenta receptora.
GYM_MP_GYM_ID=
GYM_MP_ACCESS_TOKEN=
GYM_MP_COLLECTOR_ID=
